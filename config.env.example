# Copy to config.env and fill in. config.env is gitignored.
export AWS_PROFILE=personal
export AWS_REGION=us-east-1

# Bucket holding the media. Must already exist; Terraform adopts it.
export GALLERY_BUCKET=my-gallery-bucket

# Hostname the gallery is served on. Also the WebAuthn relying-party ID,
# so changing it later invalidates every enrolled passkey.
export GALLERY_DOMAIN=photos.example.com

# Where you drop files, and where the web-ready tree is generated.
export GALLERY_SOURCE="$HOME/Movies/UploadToAWS"
export GALLERY_WEB="$HOME/Movies/UploadToAWS-web"
